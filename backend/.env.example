# Database
# Untuk Docker: hostname "db" adalah nama service Docker Compose.
# Untuk non-Docker (lokal): ganti "db" dengan "localhost".
DATABASE_URL="postgresql://blog_user:blog_password@db:5432/blog_db?schema=public"

# PostgreSQL credentials (digunakan oleh service "db" di Docker Compose)
POSTGRES_DB="blog_db"
POSTGRES_USER="blog_user"
POSTGRES_PASSWORD="blog_password"

# PostgreSQL superuser (for creating databases/users via psql -U postgres)
# POSTGRES_SUPERUSER_PASSWORD="your-superuser-password-here"

# JWT
JWT_SECRET="your-strong-secret-key-here"
JWT_EXPIRES_IN="24h"
JWT_USER_EXPIRES_IN="7d"

# Admin credentials (server-side only)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Server
PORT=3001
NODE_ENV=development
